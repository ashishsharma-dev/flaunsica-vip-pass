# Supabase Configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Client Supabase Configuration (Public)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Email Configuration (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Flaunsica VIP Pass <vip@notify.flaunsica.com>"

# Optional Twilio Configuration (for SMS OTP)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Site Protection & Lock Screen
SHOW_LOCK_SCREEN="true"
VITE_SHOW_LOCK_SCREEN="true"
SITE_PASSWORD="your-site-password"
VITE_SITE_PASSWORD="your-site-password"

